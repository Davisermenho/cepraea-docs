{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cepraea:esp-aut-git-001:espaut-config:0.1.0",
  "title": "ESP-AUT — Configuração local",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_mode",
    "preservation_events",
    "eligible_patterns",
    "ai_enabled",
    "auto_commit",
    "resolver_roles",
    "merge_policy",
    "correction_max_attempts",
    "retention_policy",
    "ci_required"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trigger_mode": {
      "type": "string",
      "enum": [
        "explicit",
        "hook",
        "watch",
        "session"
      ]
    },
    "preservation_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligible_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_enabled": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "github_repository": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "authorized_merge_repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "auto_commit": {
      "type": "boolean"
    },
    "auto_task": {"type": "boolean"},
    "auto_pr": {"type": "boolean"},
    "auto_ready": {"type": "boolean"},
    "auto_merge": {"type": "boolean"},
    "auto_followup": {"type": "boolean"},
    "auto_async": {"type": "boolean"},
    "push_remote": {"type": "string", "minLength": 1},
    "pr_head_owner": {"type": ["string", "null"]},
    "pr_base_branch": {"type": "string", "minLength": 1},
    "review_required": {"type": "boolean"},
    "followup_interval_seconds": {"type": "integer", "minimum": 5, "maximum": 300},
    "followup_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "acceptance_commands": {"type": "object"},
    "default_acceptance_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "acceptance_timeout_seconds": {"type": "integer", "minimum": 1},
    "resolver_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merge_policy": {
      "type": "string",
      "enum": [
        "manual",
        "semi_auto",
        "auto",
        "automatic"
      ]
    },
    "correction_max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "retention_policy": {
      "type": "string",
      "enum": [
        "retain_all",
        "retain_recent",
        "archive"
      ]
    },
    "ci_required": {
      "type": "boolean"
    },
    "correction_test_command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ai_sharing_authorized": {
      "type": "boolean",
      "description": "Explicit permission to transmit authorized work to a connected external AI assistant; default false"
    }
  }
}
