{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cepraea:pro-doc-cons-001:u03-claim:1.1.0",
  "title": "U03 — Registro de afirmação",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "topic",
    "source",
    "proposed_statement",
    "epistemic_type",
    "authority_reference",
    "verification_status",
    "verification_results",
    "relations",
    "approval_reference",
    "context"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "claim_id": {"type": "string", "pattern": "^CLM-U03-[0-9]{4}$"},
    "topic": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "extraction_id",
        "locator_id",
        "segment_id",
        "location",
        "literal_excerpt",
        "evidence_match"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_id": {"type": "string", "minLength": 1},
        "locator_id": {"type": "string", "pattern": "^LOC-U03-[0-9]{4}$"},
        "segment_id": {"type": ["string", "null"]},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "lines"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        "literal_excerpt": {"type": "string", "minLength": 1},
        "evidence_match": {"enum": ["EXACT", "NORMALIZED"]}
      }
    },
    "proposed_statement": {"type": "string", "minLength": 1},
    "epistemic_type": {
      "enum": [
        "DECISÃO_HUMANA",
        "REGRA_DOCUMENTADA",
        "EVIDÊNCIA_OBSERVADA",
        "PROPOSTA",
        "INFERÊNCIA",
        "HIPÓTESE",
        "NÃO_DOCUMENTADO"
      ]
    },
    "authority_reference": {"type": ["object", "null"]},
    "verification_status": {"enum": ["PENDENTE", "ACEITO", "REJEITADO"]},
    "verification_results": {"type": "array"},
    "relations": {"type": "array", "items": {"type": "string"}},
    "approval_reference": {"type": ["object", "null"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_locator_ids",
        "used_segment_ids",
        "conditions",
        "exceptions",
        "dependencies",
        "limitations",
        "sufficiency"
      ],
      "properties": {
        "used_locator_ids": {"type": "array", "items": {"type": "string"}},
        "used_segment_ids": {"type": "array", "items": {"type": "string"}},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "exceptions": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "sufficiency": {"enum": ["SUFICIENTE_NO_ESCOPO", "PARCIAL", "INSUFICIENTE"]}
      }
    }
  }
}
